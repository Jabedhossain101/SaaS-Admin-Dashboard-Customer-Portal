# ==============================================================================
# SaaS Admin Dashboard & Customer Portal — Environment Variables Template
# ==============================================================================
# Duplicate this file to .env.local for local development.
# On Vercel / Production, add these variables in Project Settings > Environment Variables.

# ------------------------------------------------------------------------------
# 1. Supabase Public Credentials (Required for SSR Client & Server Components)
# ------------------------------------------------------------------------------
# Obtain from: https://supabase.com/dashboard/project/{YOUR_PROJECT_ID}/settings/api

# The unique REST & Auth endpoint for your Supabase project instance.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The public anon key (Safe for browser / Client Component access, protected by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Privileged Key (Optional / Server Operations Only)
# ------------------------------------------------------------------------------
# WARNING: NEVER prefix with NEXT_PUBLIC_ and NEVER expose this key to browser bundles.
# Used for backend scripts, administrative bypass, and privileged background workers.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Application Base URL
# ------------------------------------------------------------------------------
# Local development: http://localhost:3000
# Production / Vercel: https://your-production-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
